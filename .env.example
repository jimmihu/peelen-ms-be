SERVER_PORT=8080
GIN_MODE=debug

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=auth_db
DB_SSLMODE=disable

# Optional for inventory image and policy PDF uploads. Create the bucket first.
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=change-me
# MINIO_BUCKET=safeops
# MINIO_USE_SSL=false

AUTH_ACCESS_TOKEN_DURATION=15m
AUTH_REFRESH_TOKEN_DURATION=168h
AUTH_BCRYPT_COST=12

JWT_ACTIVE_KID=current
JWT_KEYS=current=replace-with-at-least-32-random-bytes

# Required in release mode when TLS terminates at a trusted reverse proxy.
# TRUSTED_PROXY_CIDRS=10.0.0.0/8
# Otherwise set TLS_CERT_FILE and TLS_KEY_FILE for direct TLS.
