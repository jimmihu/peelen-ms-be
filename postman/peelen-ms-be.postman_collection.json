        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// GIN_MODE=release menolak HTTP polos kecuali lewat proxy TLS tepercaya.",
          "pm.request.headers.upsert({ key: 'X-Forwarded-Proto', value: 'https' });"
        ]
      }
    }
  ],
