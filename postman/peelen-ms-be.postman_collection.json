            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user.test\",\n  \"email\": \"user.test@example.com\",\n  \"full_name\": \"User Test\",\n  \"phone\": \"081234567890\",\n  \"roles\": [\n    \"WORKER\"\n  ],\n  \"site_ids\": [],\n  \"vendor_ids\": []\n}",
              "options": {
