                { "key": "qty", "value": "10", "type": "text" },
                { "key": "status_condition", "value": "GOOD", "type": "text" },
                { "key": "image", "type": "file", "src": "" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/inventories"
          }
        },
        {
          "name": "Get inventory",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/inventories/{{inventoryId}}" }
        },
        {
          "name": "Update inventory (optional image)",
          "request": {
            "method": "PATCH",
            "description": "multipart/form-data; send only fields to change. Image is optional; select a JPEG, PNG, or WebP file (max 5 MiB).",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "qty", "value": "12", "type": "text" },
                { "key": "status_condition", "value": "GOOD", "type": "text" },
                { "key": "status", "value": "ACTIVE", "type": "text" },
                { "key": "image", "type": "file", "src": "" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/inventories/{{inventoryId}}"
          }
        },
        {
          "name": "Deactivate inventory",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/inventories/{{inventoryId}}" }
        }
      ]
    },
