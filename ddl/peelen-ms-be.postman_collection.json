  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "username", "value": "super_admin" },
    { "key": "password", "value": "ChangeMe123!" },
    { "key": "accessToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "vendorId", "value": "20000000-0000-4000-8000-000000000001" },
    { "key": "siteId", "value": "10000000-0000-4000-8000-000000000001" },
    { "key": "inventoryId", "value": "" },
    { "key": "policyId", "value": "" },
    { "key": "itemId", "value": "" },
    { "key": "pipelineId", "value": "" },
    { "key": "pipelineItemId", "value": "" },
