        {
          "name": "Create inventory (optional image)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Inventory created', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.id) pm.collectionVariables.set('inventoryId', body.data.id);"
