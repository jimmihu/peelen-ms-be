  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "if (body.access_token) pm.collectionVariables.set('accessToken', body.access_token);",
                  "if (body.user && body.user.id) pm.collectionVariables.set('userId', body.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Refresh access token",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "description": "Uses the Secure HttpOnly refresh_token cookie set by Login. Use HTTPS for this request.",
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        },
        {
          "name": "Change password",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"{{password}}\",\n  \"new_password\": \"NewPassword123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/password"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "description": "Revokes the current session. The refresh cookie is Secure; use HTTPS for cookie-based logout.",
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        },
        {
          "name": "Logout all sessions",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/logout-all"
          }
        }
      ]
    },
